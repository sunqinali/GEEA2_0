<TUV xml:lang='en-US'>CAN BusOff</TUV>
</TEXT>
<TRRECORDITEM idref='_0E13D5F0'>
<TEXT>
<TUV xml:lang='en-US'>COM_Busoff</TUV>
</TEXT>
</TRRECORDITEM>
