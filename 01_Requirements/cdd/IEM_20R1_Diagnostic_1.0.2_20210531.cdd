<UNSDEF id='_0DF23508' oid='BE595D4EB1AE4f9bA1B28813CB0563AF' temploid='D8A49906DB024f12B313FFD009E0481D' attrcatref='_05D208A0' mayBeReported='0' v='4' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Default length of memory size (in Bytes)</TUV>
</NAME>
