<TUV xml:lang='en-US'>This attribute specifies the reference to the used TP Connection contained in the ECU Extract of the ECU. </TUV>
</DESC>
<QUAL>CAN.DiagnosticConnectionRef</QUAL>
<COMMONSTRING></COMMONSTRING>
</CSTRDEF>
