<TUV xml:lang='en-US'>Timeout Ar</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, receiver side</TUV>
</DESC>
<QUAL>CAN_FD.TimeoutAr</QUAL>
</UNSDEF>
<UNSDEF id='_0DF639F8' oid='F918504C094F43d091CA3F9621242CDB' temploid='14E4F8EEFE3D4bc2BEABF7ECE58C3375' attrcatref='_05D206F0' usage='admin' v='1000' df='dec'>
