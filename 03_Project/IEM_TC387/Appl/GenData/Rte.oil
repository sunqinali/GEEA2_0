   TASK Task_Appl_10ms {
      ACTIVATION = 1:"@RO@";
      PRIORITY = 15:"@RO@";
      SCHEDULE = FULL:"@RO@";
// TIMING_PROTECTION = FALSE|TRUE; (AUTOSAR OS only)
      AUTOSTART = FALSE:"@RO@";
      ACCESSING_APPLICATION = OsApplication;
      ACCESSING_APPLICATION = OsApplication_Core1;
      ACCESSING_APPLICATION = OsApplication_Core3;
   }:"@RO@@NR@";

   TASK Task_Bsw_10ms {
