                  <IS-SERVICE>true</IS-SERVICE>
                  <SERVICE-KIND>NON-VOLATILE-RAM-MANAGER</SERVICE-KIND>
                  <OPERATIONS>
                    <CLIENT-SERVER-OPERATION UUID="9f81321f-a9c9-48ed-bd0c-51c84d397058">
                      <SHORT-NAME>SetBlockProtection</SHORT-NAME>
                      <DESC>
                        <L-2 L="FOR-ALL"/>
