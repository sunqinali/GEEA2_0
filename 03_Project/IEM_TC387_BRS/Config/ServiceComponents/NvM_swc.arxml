                  <POSSIBLE-ERRORS>
                    <APPLICATION-ERROR UUID="74b89f80-8283-43b3-b8e3-653edd8578fc">
                      <SHORT-NAME>E_NOT_OK</SHORT-NAME>
                      <ERROR-CODE>1</ERROR-CODE>
                    </APPLICATION-ERROR>
                  </POSSIBLE-ERRORS>
