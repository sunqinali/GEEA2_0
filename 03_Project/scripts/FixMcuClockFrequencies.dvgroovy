import static com.vector.cfg.automation.api.ScriptApi.*

import com.vector.cfg.automation.model.ecuc.aurix2g.ecucdefs.mcu.Mcu

daVinci {
    scriptDescription "Align the three clock outputs that differ from the TC387 reference"
    scriptTask("FixMcuClockFrequencies", DV_PROJECT) {
        taskDescription "Set HSCT, I2C and QSPI clocks to the reference values"
        code {
            transaction {
                def mcu = bswmdModel(Mcu.DefRef).single
                def clock = mcu.mcuModuleConfiguration.mcuClockSettingConfig.byName("McuClockSettingConfig_0")
                def distribution = clock.mcuClockReferencePointConfig.mcuPllDistributionSettingConfig
                def assign = { String name, double frequency ->
                    def getter = distribution.getClass().methods.find {
                        it.parameterTypes.length == 0 && it.name == "get${name}OrCreate"
                    }
                    if (getter == null) {
                        throw new IllegalStateException("Missing ${name}")
                    }
                    def parameter = getter.invoke(distribution)
                    def setter = parameter.getClass().methods.find { it.name == "setValue" && it.parameterTypes.length == 1 }
                    setter.invoke(parameter, frequency as Double)
                    scriptLogger.info(name + " = " + frequency)
                }
                assign("McuHsctFrequency", 320000000.0d)
                assign("McuI2CFrequency", 100000000.0d)
                assign("McuQspiFrequency", 100000000.0d)
            }
            activeProject().saveProject()
            scriptLogger.info("Project saved")
        }
    }
}
