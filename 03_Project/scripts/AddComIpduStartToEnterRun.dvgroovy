            scriptLogger.warn("AddComIpduStartToEnterRun is deprecated; run ReplaceComIpduCalloutWithPduGroupSwitch instead")
            throw new IllegalStateException("Use scriptTask ReplaceComIpduCalloutWithPduGroupSwitch")
        }
    }
}
