import static com.vector.cfg.automation.api.ScriptApi.*

/**
 * DEPRECATED — use ReplaceComIpduCalloutWithPduGroupSwitch.dvgroovy.
 * COM_IPDUGROUPINFO=OFF needs Com_IpduGroupControl via BswMPduGroupSwitch, not UserCallout/IpduGroupStart.
 */
daVinci {
    scriptDescription "DEPRECATED: redirects to ReplaceComIpduCalloutWithPduGroupSwitch"

    scriptTask("AddComIpduStartToEnterRun", DV_PROJECT) {
        taskDescription "Deprecated alias — runs ReplaceComIpduCalloutWithPduGroupSwitch"
